#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SERVER_PORT 8882

int main(int argc, char* argv[]) {
    int s, len, i;
    char buffer[256];
    struct sockaddr_in servAddr;

    if (argc != 2) { printf("Usage: %s <IP>\n", argv[0]); exit(1); }

    s = socket(PF_INET, SOCK_DGRAM, 0);
    memset(&servAddr, 0, sizeof(servAddr));
    servAddr.sin_family = AF_INET;
    servAddr.sin_port = htons(SERVER_PORT);
    inet_pton(AF_INET, argv[1], &servAddr.sin_addr);

    sendto(s, "GIVE", 4, 0, (struct sockaddr *)&servAddr, sizeof(servAddr));
    len = recvfrom(s, buffer, sizeof(buffer), 0, NULL, NULL);
    buffer[len] = '\0';

    printf("Original message from server: %s\n", buffer);

    // Reversing logic
    printf("Reversed message: ");
    for(i = len - 1; i >= 0; i--) {
        printf("%c", buffer[i]);
    }
    printf("\n");

    close(s);
    return 0;

   }
