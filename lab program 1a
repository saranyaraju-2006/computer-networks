struct Node
{
    char URL[50];
    char IP[20];
    char MAC[25];

    struct Node *next;
};

struct Node *hashtable[TABLESIZE]={NULL};

int hash(char URL[])
{
    int sum=0;

    int i;

    for(i=0;URL[i]!='\0';i++)
        sum+=URL[i];

    return sum%TABLESIZE;
}

void insert(char URL[],char IP[],char MAC[])
{
    int index=hash(URL);

    struct Node *newNode;

    newNode=(struct Node*)malloc(sizeof(struct Node));

    strcpy(newNode->URL,URL);
    strcpy(newNode->IP,IP);
    strcpy(newNode->MAC,MAC);

    newNode->next=hashtable[index];


    hashtable[index]=newNode;
}

struct Node *search(char URL[])
{
    int index=hash(URL);

    struct Node *temp=hashtable[index];

    while(temp!=NULL)
    {
        if(strcmp(temp->URL,URL)==0)
            return temp;

        temp=temp->next;
    }

    return NULL;
}

void deleteNode(char URL[])
{
    int index=hash(URL);

    struct Node *temp=hashtable[index];
    struct Node *prev=NULL;

    while(temp!=NULL)
    {
        if(strcmp(temp->URL,URL)==0)
        {
            if(prev==NULL)
                hashtable[index]=temp->next;
            else
                prev->next=temp->next;

            free(temp);

            printf("\nDeleted Successfully\n");

            return;
        }

        prev=temp;
        temp=temp->next;
    }

    printf("\nURL Not Found\n");
}

