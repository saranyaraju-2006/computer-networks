//====================== IP TO BINARY ======================


void ipToBinary(char ip[], char output[])
{
    int a, b, c, d;

    char t[10];

    output[0] = '\0';

    sscanf(ip, "%d.%d.%d.%d", &a, &b, &c, &d);

    decimalToBinary(a, t);
    strcat(output, t);

    decimalToBinary(b, t);
    strcat(output, t);

    decimalToBinary(c, t);
    strcat(output, t);

    decimalToBinary(d, t);
    strcat(output, t);
}

