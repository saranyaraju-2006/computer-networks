//====================== PACKET FORMATION ======================

void packetFormation()
{
    int packetSize = 20;
    int length = strlen(packet);

    int packets = length / packetSize;

    int index = 0;
    int i,j;

    if(length % packetSize != 0)
        packets++;

    printf("\n=====================================\n");
    printf("PACKETS");
    printf("\n=====================================\n");


    for(i=1;i<=packets;i++)
    {
        printf("\nPacket %d : ",i);

        for(j=0;j<packetSize;j++)
        {
            if(index < length)
                printf("%c",packet[index++]);
            else
                printf("0");
        }

        printf("\n");
    }
}
