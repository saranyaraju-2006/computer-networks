    printf("\n\n------------------------------------------");
    printf("\nMessage Statistics");
    printf("\n------------------------------------------");
    printf("\nTotal Characters : %d", size);
    printf("\nMessage Size      : %d Bytes", size);
    printf("\nMessage Size      : %d Bits", size * 8);

    printf("\n==========================================\n");
}
/*=========================================
        MESSAGE TO BINARY
=========================================*/

void messageToBinary()
{
    int i, j;
    int len;
    unsigned char ch;
    int k = 0;

    len = strlen(message);

    printf("\n==========================================");
    printf("\n        PHYSICAL LAYER");
    printf("\n==========================================");

    printf("\n\nASCII TO BINARY CONVERSION\n");

    printf("\n--------------------------------------------------------------");
    printf("\nCharacter\tASCII\t\tBinary");
    printf("\n--------------------------------------------------------------");

    for(i = 0; i < len; i++)
    {
        ch = message[i];

        printf("\n   %c\t\t%d\t\t", ch, ch);

        for(j = 7; j >= 0; j--)
        {
            if((ch >> j) & 1)
            {
                printf("1");
                binaryMessage[k++] = '1';
            }
            else
            {
                printf("0");
                binaryMessage[k++] = '0';
            }
        }

        binaryMessage[k++] = ' ';
    }

    binaryMessage[k] = '\0';

    printf("\n\n==========================================");
    printf("\nComplete Binary Message");
    printf("\n==========================================\n");

    printf("%s\n", binaryMessage);

    printf("\nBinary Length : %d Bits", k - (len - 1));

    printf("\n==========================================\n");
}
