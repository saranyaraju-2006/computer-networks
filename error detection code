/*=========================================
      CONVERT FRAMES TO BINARY STRINGS
=========================================*/

void convertFramesToBinary()
{
    int i, j, bit;
    int k;
    unsigned char ch;

    for(i = 0; i < totalFrames; i++)
    {
        k = 0;
        int len = strlen(frames[i].data);
        for(j = 0; j < len; j++)
        {
            ch = frames[i].data[j];
            for(bit = 7; bit >= 0; bit--)
            {
                if((ch >> bit) & 1)
                    binaryFrames[i][k++] = '1';
                else
                    binaryFrames[i][k++] = '0';
            }
        }
        binaryFrames[i][k] = '\0';
    }
}

/*=========================================
      FLIP BIT IN FRAME DATA
=========================================*/

void updateFrameAfterBitFlip(int frameNo,int bitPosition)
{
    int bytePosition;
    int bitInByte;
    unsigned char ch;

    if(frameNo<1 || frameNo>totalFrames)
    {
        printf("\nInvalid Frame Number");
        return;
    }

    bytePosition = bitPosition / 8;
    bitInByte = bitPosition % 8;

    if(bytePosition >= strlen(frames[frameNo-1].data))
    {
        printf("\nBit Position Out of Range");
        return;
    }

    ch = frames[frameNo-1].data[bytePosition];

    /* Flip the required bit */
    ch ^= (1 << (7-bitInByte));

    frames[frameNo-1].data[bytePosition] = ch;

    printf("\n==========================================");
    printf("\nFRAME AFTER ERROR");
    printf("\n==========================================");

    printf("\nFrame Number : %d",frameNo);

    printf("\nModified Frame Data : %s",
            frames[frameNo-1].data);

    printf("\nCharacter Changed To : %c",
            ch);

    printf("\n==========================================\n");
}

/*=========================================
        ERROR SIMULATION
=========================================*/

void simulateError()
{
    int choice;
    int packetNo;
    int frameNo;
    int bitPosition;

    int i,j;
    int length;
    unsigned char ch;

    char binaryFrame[100];
    int k=0;

    printf("\n==========================================");
    printf("\n         ERROR SIMULATION");
    printf("\n==========================================");

    printf("\n1. Normal Transmission");
    printf("\n2. Error Simulation");

    printf("\n\nEnter Choice : ");
    scanf("%d",&choice);

    if(choice==1)
    {
        printf("\nNo Error Introduced.");
        printf("\nFrames are transmitted successfully.");
        return;
    }

    printf("\nEnter Packet Number : ");
    scanf("%d",&packetNo);

    printf("Enter Frame Number : ");
    scanf("%d",&frameNo);

    if(frameNo<1 || frameNo>totalFrames)
    {
        printf("\nInvalid Frame Number.");
        return;
    }

    printf("Enter Bit Position : ");
    scanf("%d",&bitPosition);

    binaryFrame[0]='\0';
    k=0;

    length=strlen(frames[frameNo-1].data);

    for(i=0;i<length;i++)
    {
        ch=frames[frameNo-1].data[i];

        for(j=7;j>=0;j--)
        {
            if((ch>>j)&1)
                binaryFrame[k++]='1';
            else
                binaryFrame[k++]='0';
        }
    }

    binaryFrame[k]='\0';

    printf("\n==========================================");
    printf("\nORIGINAL FRAME BINARY");
    printf("\n==========================================");

    printf("\n%s\n",binaryFrame);

    if(bitPosition<0 || bitPosition>=strlen(binaryFrame))
    {
        printf("\nInvalid Bit Position.");
        return;
    }

    if(binaryFrame[bitPosition]=='0')
        binaryFrame[bitPosition]='1';
    else
        binaryFrame[bitPosition]='0';

    printf("\n==========================================");
    printf("\nMODIFIED FRAME BINARY");
    printf("\n==========================================");

    printf("\n%s\n",binaryFrame);

    printf("\n------------------------------------------");
    printf("\nPacket Modified : %d",packetNo);
    printf("\nFrame Modified  : %d",frameNo);
    printf("\nBit Modified    : %d",bitPosition);

    /* Update global records so both the raw frames and binary tracking suffer from the error */
    strcpy(binaryFrames[frameNo - 1], binaryFrame);
    updateFrameAfterBitFlip(frameNo, bitPosition);
    errorFlag = 1;

    printf("\n\nError Successfully Introduced.");

    printf("\n==========================================\n");
}
/*=========================================
            EVEN PARITY
=========================================*/

void evenParity()
{
    int i,j;
    int ones;
    char parity;

    printf("\n==========================================");
    printf("\n        EVEN PARITY CHECK");
    printf("\n==========================================");

    for(i=0;i<totalFrames;i++)
    {
        ones=0;

        for(j=0;binaryFrames[i][j]!='\0';j++)
        {
            if(binaryFrames[i][j]=='1')
                ones++;
        }

        if(ones%2==0)
            parity='0';
        else
            parity='1';

        frameEvenParity[i]=parity;

        printf("\n------------------------------------------");
        printf("\nFrame Number : %d",i+1);
        printf("\nBinary Frame : %s",binaryFrames[i]);
        printf("\nEven Parity Bit : %c",parity);
    }

    printf("\n==========================================");

    printf("\n\nReceiver Side Verification");

    for(i=0;i<totalFrames;i++)
    {
        ones=0;

        for(j=0;binaryFrames[i][j]!='\0';j++)
        {
            if(binaryFrames[i][j]=='1')
                ones++;
        }

        if(ones%2==0)
            parity='0';
        else
            parity='1';

        printf("\n------------------------------------------");
        printf("\nFrame %d",i+1);

        if(parity==frameEvenParity[i])
            printf("\nStatus : No Error Detected");
        else
            printf("\nStatus : Error Detected");
    }

    printf("\n==========================================\n");
}
