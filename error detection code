    {
        ones=0;

        for(j=0;binaryFrames[i][j]!='\0';j++)
        {
            if(binaryFrames[i][j]=='1')
                ones++;
        }

        if(ones%2==0)
            parity='1';
        else
            parity='0';

        printf("\n------------------------------------------");
        printf("\nFrame Number : %d",i+1);

        printf("\nStored Parity     : %c",frameOddParity[i]);
        printf("\nCalculated Parity : %c",parity);

        if(parity==frameOddParity[i])
            printf("\nStatus : No Error Detected");
        else
            printf("\nStatus : Error Detected");
    }

    printf("\n==========================================\n");
}
/*=========================================
                CRC
=========================================*/

void crc()
{
    char divisor[] = "1001";

    char temp[200];

    char data[200];

    int i,j,k;

    int dataLength;

    int divisorLength;

    printf("\n==========================================");
    printf("\n         CYCLIC REDUNDANCY CHECK");
    printf("\n==========================================");

    divisorLength = strlen(divisor);

    /*------------- Sender Side -------------*/

    for(i=0;i<totalFrames;i++)
    {
        strcpy(data,binaryFrames[i]);

        dataLength = strlen(data);

        for(j=0;j<divisorLength-1;j++)
            data[dataLength+j]='0';

        data[dataLength+divisorLength-1]='\0';

        strcpy(temp,data);

        for(j=0;j<dataLength;j++)
        {
            if(temp[j]=='1')
            {
                for(k=0;k<divisorLength;k++)
                {
                    if(temp[j+k]==divisor[k])
                        temp[j+k]='0';
                    else
                        temp[j+k]='1';
                }
            }
        }

        strcpy(frameCRC[i],&temp[dataLength]);

        printf("\n------------------------------------------");
        printf("\nFrame Number : %d",i+1);

        printf("\nBinary Frame : %s",binaryFrames[i]);

        printf("\nCRC Remainder : %s",frameCRC[i]);
    }

    printf("\n==========================================");

    /*------------- Receiver Side -------------*/

    printf("\n\nReceiver Side Verification");

    for(i=0;i<totalFrames;i++)
    {
        strcpy(data,binaryFrames[i]);

        strcat(data,frameCRC[i]);

        dataLength = strlen(binaryFrames[i]);

        strcpy(temp,data);

        for(j=0;j<dataLength;j++)
        {
            if(temp[j]=='1')
            {
                for(k=0;k<divisorLength;k++)
                {
                    if(temp[j+k]==divisor[k])
                        temp[j+k]='0';
                    else
                        temp[j+k]='1';
                }
            }
        }

        printf("\n------------------------------------------");
        printf("\nFrame Number : %d",i+1);

        printf("\nReceived CRC : %s",frameCRC[i]);

        if(strcmp(&temp[dataLength],"000")==0)
            printf("\nStatus : No Error Detected");
        else
            printf("\nStatus : Error Detected");
    }

    printf("\n==========================================\n");
}
/*=========================================
          INTERNET CHECKSUM
=========================================*/

void checksum()
{
    int i,j;
    unsigned int sum;
    unsigned short check;
    unsigned short word;

    char data[200];

    printf("\n==========================================");
    printf("\n        INTERNET CHECKSUM");
    printf("\n==========================================");

    /*------------ Sender Side ------------*/

    for(i=0;i<totalFrames;i++)
    {
        strcpy(data,binaryFrames[i]);

        sum = 0;

        for(j=0; data[j]!='\0'; j+=16)
        {
            word = 0;

            int k;

            for(k=0;k<16;k++)
            {
                word <<= 1;

                if(data[j+k]=='1')
                    word |= 1;

                if(data[j+k]=='\0')
                    break;
            }

            sum += word;

            while(sum>>16)
            {
                sum = (sum & 0xFFFF) + (sum>>16);
            }
        }

        check = ~sum;

        frameChecksum[i] = check;

        printf("\n------------------------------------------");
        printf("\nFrame Number : %d",i+1);

        printf("\nBinary Frame : %s",binaryFrames[i]);

        printf("\nChecksum     : %u",frameChecksum[i]);
    }

    printf("\n==========================================");

    /*------------ Receiver Side ------------*/

    printf("\n\nReceiver Side Verification");

    for(i=0;i<totalFrames;i++)
    {
        strcpy(data,binaryFrames[i]);

        sum = 0;

        for(j=0; data[j]!='\0'; j+=16)
        {
            word = 0;

            int k;

            for(k=0;k<16;k++)
            {
                word <<= 1;

                if(data[j+k]=='1')
                    word |= 1;

                if(data[j+k]=='\0')
                    break;
            }

            sum += word;

            while(sum>>16)
            {
                sum = (sum & 0xFFFF) + (sum>>16);
            }
        }

        sum += frameChecksum[i];

        while(sum>>16)
        {
            sum = (sum & 0xFFFF) + (sum>>16);
        }

        printf("\n------------------------------------------");
        printf("\nFrame Number : %d",i+1);

        printf("\nReceived Checksum : %u",frameChecksum[i]);

        if((unsigned short)sum == 0xFFFF)
            printf("\nStatus : No Error Detected");
        else
            printf("\nStatus : Error Detected");
    }

    printf("\n==========================================\n");
}
