=========================================*/

void readMessageFromFile()
{
    FILE *fp;
    int i;
    int size = 0;

    fp = fopen("input.txt", "r");

    if(fp == NULL)
    {
        printf("\nError : Cannot Open input.txt\n");
        exit(0);
    }

    i = 0;

    while((message[i] = fgetc(fp)) != EOF)
    {
        i++;
    }

    message[i] = '\0';

    fclose(fp);

    size = strlen(message);

    printf("\n==========================================");
    printf("\n        APPLICATION LAYER");
    printf("\n==========================================");

    printf("\n\nMessage Read Successfully From File\n");

    printf("\n------------------------------------------");
    printf("\nOriginal Message");
    printf("\n------------------------------------------");
