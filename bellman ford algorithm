#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h>

/* Structure for a Directed Network Link */
struct Link {
    int src, dest, weight;
    int srcPort, destPort;
    char hubName[30];
};

/* Structure for the Routing Table Entry */
struct RouteEntry {
    int source;
    int destination;
    int nextHop;
    int totalCost;
    char hostingHub[30];
    int sPort;
    int dPort;
};

/* Min-Heap Structure to sort output by shortest path cost */
struct MinHeap {
    int size;
    struct RouteEntry* array;
};

/* --- Heap Helper Functions --- */
void swap(struct RouteEntry* a, struct RouteEntry* b) {
    struct RouteEntry temp = *a;
    *a = *b;
    *b = temp;
}

void minHeapify(struct MinHeap* minHeap, int idx) {
    int smallest = idx;
    int left = 2 * idx + 1;
    int right = 2 * idx + 2;

    if (left < minHeap->size && minHeap->array[left].totalCost < minHeap->array[smallest].totalCost)
        smallest = left;
    if (right < minHeap->size && minHeap->array[right].totalCost < minHeap->array[smallest].totalCost)
        smallest = right;

    if (smallest != idx) {
        swap(&minHeap->array[smallest], &minHeap->array[idx]);
        minHeapify(minHeap, smallest);
    }
}

struct RouteEntry extractMin(struct MinHeap* minHeap) {
    struct RouteEntry root = minHeap->array[0];
    minHeap->array[0] = minHeap->array[minHeap->size - 1];
    minHeap->size--;
    minHeapify(minHeap, 0);
    return root;
}

/* --- Path Tracing --- */
int findNextHop(int parent[], int src, int dest) {
    int current;
    if (dest == src || parent[dest] == -1) return -1;
    current = dest;
    while (parent[current] != src) {
        current = parent[current];
    }
    return current;
}

/* --- Bellman-Ford Algorithm --- */
void bellmanFord(int V, int E, struct Link links[], int startNode) {
    int *dist;
    int *parent;
    int i, j, u, v, weight, total;
    struct MinHeap* heap;
    struct RouteEntry entry;
    struct RouteEntry r;

    dist = (int*)malloc(V * sizeof(int));
    parent = (int*)malloc(V * sizeof(int));

    for (i = 0; i < V; i++) {
        dist[i] = INT_MAX;
        parent[i] = -1;
    }
    dist[startNode] = 0;

    /* Relaxation: Process directed links V-1 times */
    for (i = 1; i <= V - 1; i++) {
        for (j = 0; j < E; j++) {
            u = links[j].src;
            v = links[j].dest;
            weight = links[j].weight;
            if (dist[u] != INT_MAX && dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
                parent[v] = u;
            }
        }
    }

    /* Check for Negative Cycles in Directed Graph */
    for (j = 0; j < E; j++) {
        if (dist[links[j].src] != INT_MAX && dist[links[j].src] + links[j].weight < dist[links[j].dest]) {
            printf("\nERROR: Directed negative cycle detected!\n");
            free(dist); free(parent);
            return;
        }
    }

    /* Use Heap to sort final paths by Cost */
    heap = (struct MinHeap*)malloc(sizeof(struct MinHeap));
    heap->array = (struct RouteEntry*)malloc(V * sizeof(struct RouteEntry));
    heap->size = 0;

    for (i = 0; i < V; i++) {
        if (dist[i] == INT_MAX) continue; 
        entry.source = startNode;
        entry.destination = i;
        entry.totalCost = dist[i];
        if (i == startNode) {
            entry.nextHop = i; 
            strcpy(entry.hostingHub, "Self");
            entry.sPort = 0; entry.dPort = 0;
        } else {
            entry.nextHop = findNextHop(parent, startNode, i);
            for (j = 0; j < E; j++) {
                if (links[j].dest == i && links[j].src == parent[i]) {
                    strcpy(entry.hostingHub, links[j].hubName);
                    entry.sPort = links[j].srcPort;
                    entry.dPort = links[j].destPort;
                    break;
                }
            }
        }
        heap->array[heap->size++] = entry;
    }

    for (i = (heap->size - 2) / 2; i >= 0; i--) minHeapify(heap, i);

    /* Output Table */
    printf("\n--- Directed Graph Routing Table (Sorted by Cost) ---\n");
    printf("%-8s %-8s %-10s %-8s %-20s %-8s %-8s\n", "Source", "Dest", "Next Hub", "Cost", "Hosting Hub", "S-Port", "D-Port");
    printf("------------------------------------------------------------------------------------------\n");
    total = heap->size;
    for (i = 0; i < total; i++) {
        r = extractMin(heap);
        if (r.destination == startNode)
            printf("%-8d %-8d %-10s %-8d %-20s %-8d %-8d\n", r.source, r.destination, "Local", r.totalCost, r.hostingHub, r.sPort, r.dPort);
        else
            printf("%-8d %-8d %-10d %-8d %-20s %-8d %-8d\n", r.source, r.destination, r.nextHop, r.totalCost, r.hostingHub, r.sPort, r.dPort);
    }

    free(dist); free(parent); free(heap->array); free(heap);
}

int main() {
    int V, E, start, i;
    struct Link* links;
    
    printf("Enter number of Hubs: ");
    scanf("%d", &V);
    printf("Enter number of Directed Links: ");
    scanf("%d", &E);

    links = (struct Link*)malloc(E * sizeof(struct Link));

    for (i = 0; i < E; i++) {
        printf("\n--- Directed Link %d ---\n", i + 1);
        printf("From (Source Hub): "); scanf("%d", &links[i].src);
        printf("To (Dest Hub): "); scanf("%d", &links[i].dest);
        printf("Weight: "); scanf("%d", &links[i].weight);
        printf("Source Port: "); scanf("%d", &links[i].srcPort);
        printf("Dest Port: "); scanf("%d", &links[i].destPort);
        printf("Hosting Hub Name: "); scanf("%s", links[i].hubName);
    }

    printf("\nEnter Source Hub ID to start: ");
    scanf("%d", &start);

    bellmanFord(V, E, links, start);
    free(links);
    return 0;
}
