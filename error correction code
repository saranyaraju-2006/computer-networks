/******************************************************
            UTILITY FUNCTIONS
******************************************************/
void decimalToBinary(unsigned char ch, int bits[8]) {
    int i;
    for (i = 7; i >= 0; i--) {
        bits[7 - i] = (ch >> i) & 1;
    }
}

unsigned char binaryToDecimal(int bits[8]) {
    int i;
    unsigned char val = 0;
    for (i = 0; i < 8; i++) {
        val = (val << 1) | bits[i];
    }
    return val;
}

void display8x5Matrix(int matrix[MATRIX_ROWS][MATRIX_COLS]) {
    int r, c;
    printf("\n        B1 B2 B3 B4 B5\n");
    for (r = 0; r < MATRIX_ROWS; r++) {
        printf("R%-6d  ", r + 1);
        for (c = 0; c < MATRIX_COLS; c++) {
            printf("%d  ", matrix[r][c]);
        }
        printf("\n");
    }
}

/******************************************************
            OSI LAYER SIMULATION
******************************************************/
void applicationLayer() {
    FILE *fp = fopen("input.txt", "r");
    if (!fp) {
        fp = fopen("input.txt", "w");
        fprintf(fp, "COMPUTER NETWORKS LAB");
        fclose(fp);
        fp = fopen("input.txt", "r");
    }
    fgets(originalMessage, MAX_MESSAGE_SIZE, fp);
    originalMessage[strcspn(originalMessage, "\n")] = '\0';
    fclose(fp);
    printf("\n[APPLICATION LAYER] Message Read: %s\n", originalMessage);
}

void transportLayer() {
    int i, length, start = 0;
    sourcePort = rand() % 50000 + 1024;
    destPort = rand() % 50000 + 1024;
    length = strlen(originalMessage);
    totalPackets = (length / PACKET_DATA_SIZE) + (length % PACKET_DATA_SIZE != 0);

    for (i = 0; i < totalPackets; i++) {
        packets[i].packetNumber = i + 1;
        packets[i].sourcePort = sourcePort;
        packets[i].destinationPort = destPort;
        strcpy(packets[i].sourceIP, sourceIP);
        strcpy(packets[i].destinationIP, destIP);
        memset(packets[i].data, '\0', PACKET_DATA_SIZE + 1);
        strncpy(packets[i].data, originalMessage + start, PACKET_DATA_SIZE);
        start += PACKET_DATA_SIZE;
        printf("[TRANSPORT LAYER] Packet %d Created (Payload: %s)\n", packets[i].packetNumber, packets[i].data);
    }
    printf("[TRANSPORT LAYER] Auto-generated Source Port: %d, Dest Port: %d\n", sourcePort, destPort);
}

void networkAndDataLinkLayers() {
    int p, f, start, pktLen;
    for (p = 0; p < totalPackets; p++) {
        pktLen = strlen(packets[p].data);
        totalFramesPerPacket[p] = (pktLen / FRAME_DATA_SIZE) + (pktLen % FRAME_DATA_SIZE != 0);
        start = 0;
        for (f = 0; f < totalFramesPerPacket[p]; f++) {
            frames[p][f].packetNumber = p + 1;
            frames[p][f].frameNumber = f + 1;
            strcpy(frames[p][f].sourceMAC, sourceMAC);
            strcpy(frames[p][f].destinationMAC, destMAC);
            memset(frames[p][f].data, '\0', FRAME_DATA_SIZE + 1);
            strncpy(frames[p][f].data, packets[p].data + start, FRAME_DATA_SIZE);
            start += FRAME_DATA_SIZE;
            printf("[DATA LINK LAYER] Packet %d -> Frame %d (Data: %s)\n", p + 1, f + 1, frames[p][f].data);
        }
    }
}

void physicalLayerSender() {
    int p, f, i, j, k, index, bits[8], sum;
    for (p = 0; p < totalPackets; p++) {
        for (f = 0; f < totalFramesPerPacket[p]; f++) {
            index = 0;
            for (i = 0; i < MATRIX_ROWS; i++) {
                for (j = 0; j < MATRIX_COLS; j++) {
                    senderMatrix[p][f].bit[i][j] = 0;
                }
            }

            for (i = 0; i < (int)strlen(frames[p][f].data); i++) {
                decimalToBinary((unsigned char)frames[p][f].data[i], bits);
                for (k = 0; k < 8; k++) {
                    int r = index / MATRIX_COLS;
                    int c = index % MATRIX_COLS;
                    if (r < MATRIX_ROWS) {
                        senderMatrix[p][f].bit[r][c] = bits[k];
                    }
                    index++;
                }
            }

            /* Calculate Row Parity */
            for (i = 0; i < MATRIX_ROWS; i++) {
                sum = 0;
                for (j = 0; j < MATRIX_COLS; j++) {
                    sum += senderMatrix[p][f].bit[i][j];
                }
                senderMatrix[p][f].rowParity[i] = sum % 2;
            }

            /* Calculate Column Parity */
            for (j = 0; j < MATRIX_COLS; j++) {
                sum = 0;
                for (i = 0; i < MATRIX_ROWS; i++) {
                    sum += senderMatrix[p][f].bit[i][j];
                }
                senderMatrix[p][f].columnParity[j] = sum % 2;
            }
        }
    }
    printf("[PHYSICAL LAYER] 8x5 Binary Matrices and 2D Parity generated.\n");
}

/******************************************************
            RECEIVER SIDE & REPORT
******************************************************/
void receiverProcess() {
    int p, f, r, c, i, j, k, sum, badR, badC, index, bits[8];
    unsigned char val;
    recoveredMessage[0] = '\0';

    for (p = 0; p < totalPackets; p++) {
        for (f = 0; f < totalFramesPerPacket[p]; f++) {
            for (r = 0; r < MATRIX_ROWS; r++) {
                for (c = 0; c < MATRIX_COLS; c++) {
                    receiverMatrix[p][f].bit[r][c] = senderMatrix[p][f].bit[r][c];
                }
            }

            /* Inject Manual Error if selected */
            if (errorFlag && (p + 1) == errP && (f + 1) == errF) {
                printf("\n[CHANNEL] Before Error Matrix (P%d, F%d):", errP, errF);
                display8x5Matrix(receiverMatrix[p][f].bit);
                
                receiverMatrix[p][f].bit[errR - 1][errC - 1] ^= 1;
                
                printf("\n[CHANNEL] After Error Matrix (P%d, F%d - Row %d, Col %d flipped):", errP, errF, errR, errC);
                display8x5Matrix(receiverMatrix[p][f].bit);
            }

            /* 2D Parity Detection */
            badR = -1;
            badC = -1;
            for (i = 0; i < MATRIX_ROWS; i++) {
                sum = 0;
                for (j = 0; j < MATRIX_COLS; j++) {
                    sum += receiverMatrix[p][f].bit[i][j];
                }
                if ((sum % 2) != senderMatrix[p][f].rowParity[i]) {
                    badR = i;
                }
            }
            for (j = 0; j < MATRIX_COLS; j++) {
                sum = 0;
                for (i = 0; i < MATRIX_ROWS; i++) {
                    sum += receiverMatrix[p][f].bit[i][j];
                }
                if ((sum % 2) != senderMatrix[p][f].columnParity[j]) {
                    badC = j;
                }
            }

            /* Hamming Syndrome Correction */
            if (badR != -1 && badC != -1) {
                printf("\n[RECEIVER] 2D Parity Mismatch Detected at Packet %d Frame %d -> Row %d, Col %d\n", p + 1, f + 1, badR + 1, badC + 1);
                printf("[RECEIVER] Hamming Syndrome = %d\n", (badR + 1) * 10 + (badC + 1));
                receiverMatrix[p][f].bit[badR][badC] ^= 1;
                printf("[RECEIVER] Corrected Bit at Row %d, Col %d. Matrix Restored.\n", badR + 1, badC + 1);
            }

            /* Reconstruct ASCII String */
            index = 0;
            for (i = 0; i < (int)strlen(frames[p][f].data); i++) {
                for (k = 0; k < 8; k++) {
                    int currR = index / MATRIX_COLS;
                    int currC = index % MATRIX_COLS;
                    bits[k] = receiverMatrix[p][f].bit[currR][currC];
                    index++;
                }
                val = binaryToDecimal(bits);
                char temp[2] = {(char)val, '\0'};
                strcat(recoveredMessage, temp);
            }
        }
    }
}

void generateReport() {
    FILE *out = fopen("output.txt", "w");
    if (!out) {
        printf("Error: Could not open output.txt for writing.\n");
        return;
    }
    fprintf(out, "=============================\n");
    fprintf(out, "NETWORK TRANSMISSION REPORT\n");
    fprintf(out, "=============================\n\n");
    fprintf(out, "Input File    : input.txt\n");
    fprintf(out, "Sender URL    : %s (%s - %s)\n", senderURL, sourceIP, sourceMAC);
    fprintf(out, "Receiver URL  : %s (%s - %s)\n", receiverURL, destIP, destMAC);
    fprintf(out, "Source Port   : %d\n", sourcePort);
    fprintf(out, "Dest Port     : %d\n", destPort);
    fprintf(out, "Mode          : %s\n\n", (errorFlag ? "Manual Error Injection" : "Normal Transmission"));
    
    if (errorFlag) {
        fprintf(out, "Sender\n------\nPacket Number : %d\nFrame Number  : %d\n\n", errP, errF);
        fprintf(out, "Receiver\n--------\nError Position:\nRow = %d\nColumn = %d\n\n", errR, errC);
        fprintf(out, "2D Parity     : Error Detected\n");
        fprintf(out, "Hamming Code  : Correction Successful\n");
        fprintf(out, "Parity Status : MATCHED (After Correction)\n\n");
    } else {
        fprintf(out, "Status        : Transmitted without Errors\n\n");
    }

    fprintf(out, "Original Message : %s\n", originalMessage);
    fprintf(out, "Received Message : %s\n", recoveredMessage);
    fprintf(out, "\nStatus : Transmission Successful\n");
    fclose(out);
    printf("\n[SYSTEM] Detailed transmission report written to output.txt\n");
}

