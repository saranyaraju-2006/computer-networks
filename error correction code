/******************************************************
    CONSTANTS & DEFINITIONS
******************************************************/
#define MAX_MESSAGE_SIZE    2048
#define MAX_BINARY_SIZE     16384
#define PACKET_DATA_SIZE    20
#define FRAME_DATA_SIZE     5   /* 5 bytes per frame for 8x5 matrix */
#define MATRIX_ROWS         8
#define MATRIX_COLS         5
#define MAX_PACKETS         200
#define MAX_FRAMES          20
#define HASH_SIZE           31
#define TOTAL_BITS          46
#define PARITY_BITS         6

#define IP_VERSION          4
#define HEADER_LENGTH       20
#define DEFAULT_TTL         64
#define TCP_PROTOCOL        6

/******************************************************
                    STRUCTURES
******************************************************/
typedef struct {
    int packetNumber;
    char sourceIP[20], destinationIP[20];
    int sourcePort, destinationPort;
    char data[PACKET_DATA_SIZE + 1];
} Packet;

typedef struct {
    int frameNumber;
    int packetNumber;
    char sourceMAC[20], destinationMAC[20];
    char data[FRAME_DATA_SIZE + 1];
} Frame;

typedef struct {
    int bit[MATRIX_ROWS][MATRIX_COLS];
    int rowParity[MATRIX_ROWS];
    int columnParity[MATRIX_COLS];
} BinaryMatrix;

typedef struct {
    char url[100];
    char ip[20];
    char mac[20];
} DNSRecord;

typedef struct HashNode {
    DNSRecord device;
    struct HashNode *next;
} HashNode;

typedef struct {
    int data[TOTAL_BITS + 1];
} HammingFrame;

/******************************************************
        GLOBAL VARIABLES
******************************************************/
HashNode *hashTable[HASH_SIZE];
Packet packets[MAX_PACKETS];
Frame frames[MAX_PACKETS][MAX_FRAMES];
BinaryMatrix senderMatrix[MAX_PACKETS][MAX_FRAMES];
BinaryMatrix receiverMatrix[MAX_PACKETS][MAX_FRAMES];
HammingFrame senderHamming[MAX_PACKETS][MAX_FRAMES];

int totalPackets = 0;
int totalFramesPerPacket[MAX_PACKETS];
char originalMessage[MAX_MESSAGE_SIZE];
char recoveredMessage[MAX_MESSAGE_SIZE];

char sourceIP[20], destIP[20], sourceMAC[20], destMAC[20];
char senderURL[100], receiverURL[100];
int sourcePort, destPort;
int transmissionMode = 1;
int errorFlag = 0;

/* Error location variables */
int errP, errF, errR, errC;

/******************************************************
            HASH TABLE FUNCTIONS
******************************************************/
int hashFunction(char url[]) {
    int sum = 0, i;
    for (i = 0; url[i] != '\0'; i++) {
        sum += url[i];
    }
    return sum % HASH_SIZE;
}

void insertNode(char url[], char ip[], char mac[]) {
    int index = hashFunction(url);
    HashNode *newNode = (HashNode*)malloc(sizeof(HashNode));
    strcpy(newNode->device.url, url);
    strcpy(newNode->device.ip, ip);
    strcpy(newNode->device.mac, mac);
    newNode->next = hashTable[index];
    hashTable[index] = newNode;
}

int lookupURL(char url[], char ip[], char mac[]) {
    int index = hashFunction(url);
    HashNode *temp = hashTable[index];
    while (temp) {
        if (strcmp(temp->device.url, url) == 0) {
            strcpy(ip, temp->device.ip);
            strcpy(mac, temp->device.mac);
            return 1;
        }
        temp = temp->next;
    }
    return 0;
}

