#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SERVER_PORT 8881

int main(int argc, char* argv[]) {
    int s, len;
    char buffer[256];
    char sendMsg[256];
    struct sockaddr_in servAddr;

    if (argc != 2) { 
        printf("Usage: %s <Server_IP>\n", argv[0]); 
        exit(1); 
    }

    
    s = socket(PF_INET, SOCK_DGRAM, 0);

    memset(&servAddr, 0, sizeof(servAddr));
    servAddr.sin_family = AF_INET;
    servAddr.sin_port = htons(SERVER_PORT);
    inet_pton(AF_INET, argv[1], &servAddr.sin_addr);

    
    printf("Enter message to send to server: ");
    fgets(sendMsg, sizeof(sendMsg), stdin);
    sendMsg[strcspn(sendMsg, "\n")] = 0; // Remove the trailing newline

    
    sendto(s, sendMsg, strlen(sendMsg), 0, (struct sockaddr *)&servAddr, sizeof(servAddr));
    printf("Message sent. Waiting for server response...\n");

    len = recvfrom(s, buffer, sizeof(buffer) - 1, 0, NULL, NULL);
    buffer[len] = '\0';

    printf("Received from server: %s\n", buffer);

    close(s);
    return 0;
}
