=========================================*/

TransportPacket transport[MAX_PACKETS];

/*=========================================
        Generate H4 Header
=========================================*/

void generateTransportHeader()
{
    srand(time(NULL));

    transport[0].H4 = 1000 + rand() % 9000;
}

/*=========================================
      Generate Source and Destination Ports
=========================================*/

void generatePorts()
{
    transport[0].sourcePort = 1024 + rand() % 5000;

    transport[0].destinationPort = 1024 + rand() % 5000;
}

/*=========================================
      Calculate Number of Packets
=========================================*/

void calculatePackets()
{
    int length;

    length = application.bytes;

    transport[0].packetCount =
        (length + MAX_PACKET_SIZE - 1) / MAX_PACKET_SIZE;
}

/*=========================================
        Create Packets
=========================================*/

void createPackets()
{
    int i;

    int start = 0;

    int length = application.bytes;

    calculatePackets();

    for(i=0;i<transport[0].packetCount;i++)
    {
        transport[i].packetNumber = i + 1;

        transport[i].H4 = transport[0].H4;

        transport[i].sourcePort =
            transport[0].sourcePort;

        transport[i].destinationPort =
            transport[0].destinationPort;

        strncpy(
                transport[i].data,
                application.message + start,
                MAX_PACKET_SIZE
              );

        transport[i].data[MAX_PACKET_SIZE]='\0';

        transport[i].packetSize =
            strlen(transport[i].data);

        start = start + MAX_PACKET_SIZE;

        if(start >= length)
            break;
    }
}

/*=========================================
        String to Binary
=========================================*/

void stringToBinary(char input[],char output[])
{
    int i;

    int j;

    int k = 0;

    for(i=0;input[i]!='\0';i++)
    {
        for(j=7;j>=0;j--)
        {
            if((input[i]>>j)&1)
                output[k++]='1';
            else
                output[k++]='0';
        }
    }

    output[k]='\0';
}

/*=========================================
        Convert Packet into Binary
=========================================*/

void convertPacketBinary()
{
    int i;

    for(i=0;i<transport[0].packetCount;i++)
    {
        stringToBinary(
                transport[i].data,
                transport[i].binary
                      );
    }
}

