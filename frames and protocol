ApplicationPacket application;

/*==========================================
    Read Message From File
==========================================*/

void readMessage()
{
    FILE *fp;

    fp = fopen("message.txt", "r");

    if(fp == NULL)
    {
        printf("\nUnable to Open message.txt\n");
        exit(0);
    }

    fgets(application.message, MAX_MESSAGE, fp);

    fclose(fp);

    application.message[strcspn(application.message, "\n")] = '\0';
}

/*==========================================
    Calculate Message Size
==========================================*/

void calculateMessageSize()
{
    application.messageLength = strlen(application.message);

    application.bytes = application.messageLength;

    application.bits = application.bytes * 8;
}

/*==========================================
    Generate Application Header
==========================================*/

void generateApplicationHeader()
{
    srand(time(NULL));

    application.H5 = 1000 + rand() % 9000;
}

/*==========================================
    Display Application Layer
==========================================*/

void displayApplicationLayer()
{
    printf("\n");
    printf("=====================================================\n");
    printf("            APPLICATION LAYER (L5)\n");
    printf("=====================================================\n");

    printf("Application Header (H5) : %d\n", application.H5);

    printf("Message                 : %s\n", application.message);

    printf("Characters              : %d\n", application.messageLength);

    printf("Data Size               : %d Bytes\n", application.bytes);

    printf("Binary Size             : %d Bits\n", application.bits);

    printf("=====================================================\n");
}

/*==========================================
    Application Layer
==========================================*/

void applicationLayer()
{
    readMessage();

    calculateMessageSize();

    generateApplicationHeader();

    displayApplicationLayer();
}
