/*==========================
    Global Hash Table
===========================*/

HashNode hashTable[TABLE_SIZE];

/*==========================
    Initialize Hash Table
===========================*/

void initializeHash()
{
    int i;

    for(i=0;i<TABLE_SIZE;i++)
    {
        hashTable[i].status=0;

        strcpy(hashTable[i].url,"");

        strcpy(hashTable[i].ip,"");

        strcpy(hashTable[i].mac,"");
    }
}

/*==========================
    Hash Function
===========================*/

int hashFunction(char url[])
{
    int i;

    int sum=0;

    for(i=0;url[i]!='\0';i++)
    {
        sum=sum+url[i];
    }

    return(sum%TABLE_SIZE);
}

/*==========================
    Insert Record
===========================*/

void insertRecord(char url[],char ip[],char mac[])
{
    int index;

    int start;

    index=hashFunction(url);

    start=index;

    while(hashTable[index].status==1)
    {
        index=(index+1)%TABLE_SIZE;

        if(index==start)
        {
            printf("\nHash Table Full.\n");
            return;
        }
    }

    strcpy(hashTable[index].url,url);

    strcpy(hashTable[index].ip,ip);

    strcpy(hashTable[index].mac,mac);

    hashTable[index].status=1;

    printf("\nRecord Inserted Successfully.\n");
}

/*==========================
    Search Record
===========================*/

int searchRecord(char url[],char ip[],char mac[])
{
    int index;

    int start;

    index=hashFunction(url);

    start=index;

    while(hashTable[index].status!=0)
    {
        if(hashTable[index].status==1 &&
           strcmp(hashTable[index].url,url)==0)
        {
            strcpy(ip,hashTable[index].ip);

            strcpy(mac,hashTable[index].mac);

            return 1;
        }

        index=(index+1)%TABLE_SIZE;

        if(index==start)
            break;
    }

    return 0;
}

/*==========================
    Delete Record
===========================*/

void deleteRecord(char url[])
{
    int index;

    int start;

    index=hashFunction(url);

    start=index;

    while(hashTable[index].status!=0)
    {
        if(hashTable[index].status==1 &&
           strcmp(hashTable[index].url,url)==0)
        {
            hashTable[index].status=2;

            strcpy(hashTable[index].url,"");

            strcpy(hashTable[index].ip,"");

            strcpy(hashTable[index].mac,"");

            printf("\nRecord Deleted Successfully.\n");

            return;
        }

        index=(index+1)%TABLE_SIZE;

        if(index==start)
            break;
    }

    printf("\nURL Not Found.\n");
}

/*==========================
    Display Hash Table
===========================*/

void displayHash()
{
    int i;

    printf("\n==========================================================================");

    printf("\nIndex\tURL\t\t\tIP Address\t\tMAC Address");

    printf("\n==========================================================================");

    for(i=0;i<TABLE_SIZE;i++)
    {
        if(hashTable[i].status==1)
        {
            printf("\n%d\t%-20s\t%-15s\t%s",
                   i,
                   hashTable[i].url,
                   hashTable[i].ip,
                   hashTable[i].mac);
        }
    }

    printf("\n==========================================================================\n");
}

