/*=====================================================
        Generate Trailer T2
======================================================*/

void generateTrailer()
{
    strcpy(datalink.trailer,"0000000000000000");
}

/*=====================================================
        Calculate Frames
======================================================*/

void calculateFrames()
{
    int i;

    int frameNo=1;

    int totalFrames=0;

    for(i=0;i<transport[0].packetCount;i++)
    {
        int size;

        size=transport[i].packetSize;

        totalFrames+=(size+MAX_FRAME_SIZE-1)/MAX_FRAME_SIZE;
    }

    datalink.totalFrames=totalFrames;

    for(i=0;i<transport[0].packetCount;i++)
    {
        int remaining;

        remaining=transport[i].packetSize;

        while(remaining>0)
        {
            frames[frameNo-1].frameNumber=frameNo;

            frames[frameNo-1].packetNumber=
            transport[i].packetNumber;

            if(remaining>=MAX_FRAME_SIZE)
            {
                frames[frameNo-1].frameSize=
                MAX_FRAME_SIZE;
            }
            else
            {
                frames[frameNo-1].frameSize=
                remaining;
            }

            remaining-=MAX_FRAME_SIZE;

            frameNo++;
        }
    }
}

/*=====================================================
        Create Frames
======================================================*/

void createFrames()
{
    int i;

    int frameIndex=0;

    for(i=0;i<transport[0].packetCount;i++)
    {
        int start=0;

        while(start<transport[i].packetSize)
        {
            strncpy(frames[frameIndex].frame,
                    transport[i].data+start,
                    MAX_FRAME_SIZE);

            frames[frameIndex].frame[MAX_FRAME_SIZE]='\0';

            start+=MAX_FRAME_SIZE;

            frameIndex++;
        }
    }
}

