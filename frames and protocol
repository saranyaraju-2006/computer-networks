/*==============================================
        Sentinel Sender
===============================================*/

void sentinelSender()
{
    int i;

    char temp[MAX_BINARY];

    for(i=0;i<datalink.totalFrames;i++)
    {
        strcpy(temp,"");

        strcat(temp,"<STX>");

        strcat(temp,"|H2:");

        sprintf(temp+strlen(temp),"%d",datalink.H2);

        strcat(temp,"|");

        strcat(temp,datalink.sourceMAC);

        strcat(temp,"|");

        strcat(temp,datalink.destinationMAC);

        strcat(temp,"|H3:");

        sprintf(temp+strlen(temp),"%d",network.H3);

        strcat(temp,"|H4:");

        sprintf(temp+strlen(temp),"%d",transport[0].H4);

        strcat(temp,"|H5:");

        sprintf(temp+strlen(temp),"%d",application.H5);

        strcat(temp,"|");

        strcat(temp,frames[i].frame);

        strcat(temp,"|");

        strcat(temp,datalink.trailer);

        strcat(temp,"<ETX>");

        strcpy(sentinelFrame[i].frame,temp);
    }

    printf("\n");
    printf("===============================================\n");
    printf("     SENTINEL FRAMING - SENDER\n");
    printf("===============================================\n");

    for(i=0;i<datalink.totalFrames;i++)
    {
        printf("\nFrame %d\n",i+1);

        printf("%s\n",sentinelFrame[i].frame);

        printf("---------------------------------------\n");
    }
}

/*==============================================
        Sentinel Receiver
===============================================*/

void sentinelReceiver()
{
    int i;

    char *start;

    char *end;

    char data[MAX_BINARY];

    printf("\n");
    printf("===============================================\n");
    printf("     SENTINEL FRAMING - RECEIVER\n");
    printf("===============================================\n");

    for(i=0;i<datalink.totalFrames;i++)
    {
        start=strstr(sentinelFrame[i].frame,"<STX>");

        end=strstr(sentinelFrame[i].frame,"<ETX>");

        if(start!=NULL && end!=NULL)
        {
            start+=5;

            strncpy(data,start,end-start);

            data[end-start]='\0';

            printf("\nFrame %d Received\n",i+1);

            printf("%s\n",data);

            printf("---------------------------------------\n");
        }
    }
}
