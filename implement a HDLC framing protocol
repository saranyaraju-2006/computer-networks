#include <stdio.h>
#include <string.h>

void hdlc_encode(char *data, char *frame) {
    int count = 0;
    int j = 0;
    int i; /* Declared outside loop for C89/C90 compliance */

    /* Add Opening Flag "01111110" */
    strcpy(frame, "01111110");
    j = 8;

    for (i = 0; data[i] != '\0'; i++) {
        frame[j++] = data[i];

        if (data[i] == '1') {
            count++;
        } else {
            count = 0;
        }

        /* Bit Stuffing: Insert '0' after five consecutive '1's */
        if (count == 5) {
            frame[j++] = '0';
            count = 0;
        }
    }

    /* Add Closing Flag "01111110" */
    strcat(frame, "01111110");
}

void hdlc_decode(char *frame, char *data) {
    int count = 0;
    int j = 0;
    int len = strlen(frame);
    int i; /* Declared outside loop for C89/C90 compliance */

    /* Skip opening flag (index 0-7) and closing flag (last 8 bits) */
    for (i = 8; i < len - 8; i++) {
        data[j++] = frame[i];

        if (frame[i] == '1') {
            count++;
        } else {
            count = 0;
        }

        /* Bit Destuffing: Skip the next '0' after five consecutive '1's */
        if (count == 5 && frame[i + 1] == '0') {
            i++;
            count = 0;
        }
    }
    data[j] = '\0';
}

int main() {
    char data[] = "11111101111111"; /* Sample binary data payload */
    char frame[100] = {0};
    char decoded[100] = {0};

    printf("Original Data: %s\n", data);

    hdlc_encode(data, frame);
    printf("HDLC Frame   : %s\n", frame);

    hdlc_decode(frame, decoded);
    printf("Decoded Data : %s\n", decoded);

    return 0;
}
