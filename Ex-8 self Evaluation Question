To make these pairs robust and distinct, the Clients handle the menus and user inputs, sending formatted command strings (e.g., 1 for search, 2 101 to book ID 101) to the Servers. The servers iteratively process one client at a time, update their local databases, log activities to a file, and return the response.



1. Online Railway Reservation Client (railway_client.c)

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define PORT 8081

struct Train { int id; char name[30]; char route[30]; int seats; float fare; };
struct Train db[2] = {{101, "Shatabdi", "NY-DC", 50, 120.0}, {102, "Express", "LA-SF", 30, 85.0}};

void log_activity(const char *msg) {
    FILE *f = fopen("railway_log.txt", "a");
    if(f) {
        time_t t = time(NULL); char *tm = ctime(&t); tm[strlen(tm)-1] = 0;
        fprintf(f, "[%s] %s\n", tm, msg); fclose(f);
    }
}

int main() {
    int server_sock = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in addr = { .sin_family = AF_INET, .sin_port = htons(PORT), .sin_addr.s_addr = INADDR_ANY };
    bind(server_sock, (struct sockaddr*)&addr, sizeof(addr));
    listen(server_sock, 5);
    printf("Iterative Railway Server listening on %d...\n", PORT);

    while(1) {
        int client_sock = accept(server_sock, NULL, NULL);
        char buffer[1024], response[2048];
        log_activity("Client connected.");
        
        while(read(client_sock, buffer, sizeof(buffer)) > 0) {
            int cmd = 0, id = 0;
            sscanf(buffer, "%d %d", &cmd, &id);
            memset(response, 0, sizeof(response));
            
            if (cmd == 1) { // Search
                strcpy(response, "ID\tName\tRoute\tSeats\tFare\n");
                for(int i=0; i<2; i++) {
                    char temp[100];
                    sprintf(temp, "%d\t%s\t%s\t%d\t%.2f\n", db[i].id, db[i].name, db[i].route, db[i].seats, db[i].fare);
                    strcat(response, temp);
                }
                log_activity("Searched trains.");
            } else if (cmd == 2 || cmd == 3) {
                int found = -1;
                for(int i=0; i<2; i++) if (db[i].id == id) found = i;
                if (found != -1) {
                    if (cmd == 2 && db[found].seats > 0) {
                        db[found].seats--; strcpy(response, "Booking Successful!"); log_activity("Ticket booked.");
                    } else if (cmd == 3) {
                        db[found].seats++; strcpy(response, "Cancellation Successful!"); log_activity("Ticket cancelled.");
                    } else {
                        strcpy(response, "Error: No seats available."); log_activity("Booking failed (full).");
                    }
                } else {
                    strcpy(response, "Error: Invalid Train ID."); log_activity("Invalid Train ID requested.");
                }
            }
            send(client_sock, response, strlen(response), 0);
            memset(buffer, 0, sizeof(buffer));
        }
        close(client_sock);
        log_activity("Client disconnected.");
    }
    return 0;
}

