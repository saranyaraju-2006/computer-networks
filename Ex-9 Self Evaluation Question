3. Concurrent File Sharing Server
Server (fileshare_server.c)

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <pthread.h>
#include <fcntl.h>

#define PORT 9003
#define BUFFER_SIZE 1024

void *client_handler(void *arg) {
    int sock = *(int *)arg;
    free(arg);
    char buffer[BUFFER_SIZE];

    while (1) {
        memset(buffer, 0, sizeof(buffer));
        int bytes = read(sock, buffer, sizeof(buffer));
        if (bytes <= 0) break;

        buffer[strcspn(buffer, "\r\n")] = 0;

        if (strcmp(buffer, "LIST") == 0) {
            // Return catalog of available files
            const char *file_list = "Available Files:\n- test1.txt\n- sample.pdf\n- notes.txt\n";
            send(sock, file_list, strlen(file_list), 0);
        } else if (strncmp(buffer, "GET ", 4) == 0) {
            char *filename = buffer + 4;
            FILE *fp = fopen(filename, "rb");

            if (fp == NULL) {
                char *err = "ERROR: File not found.\n";
                send(sock, err, strlen(err), 0);
            } else {
                char ack[] = "START";
                send(sock, ack, strlen(ack), 0);
                usleep(50000); // Allow client to switch to receiving mode

                int n;
                char data[BUFFER_SIZE];
                while ((n = fread(data, 1, sizeof(data), fp)) > 0) {
                    send(sock, data, n, 0);
                }
                fclose(fp);
                usleep(50000);
                send(sock, "EOF_REACHED", 11, 0);
            }
        }
    }

    close(sock);
    return NULL;
}

int main() {
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    struct sockaddr_in addr = { .sin_family = AF_INET, .sin_port = htons(PORT), .sin_addr.s_addr = INADDR_ANY };
    bind(server_fd, (struct sockaddr *)&addr, sizeof(addr));
    listen(server_fd, 10);
    printf("File Sharing Server running on port %d...\n", PORT);

    while (1) {
        int *client_sock = malloc(sizeof(int));
        *client_sock = accept(server_fd, NULL, NULL);
        pthread_t tid;
        pthread_create(&tid, NULL, client_handler, client_sock);
        pthread_detach(tid);
    }
    close(server_fd);
    return 0;
}



