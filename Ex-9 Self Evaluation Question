#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <pthread.h>

#define PORT 9004
#define BUFFER_SIZE 2048

int sock = 0;
char username[50];

void *recv_handler(void *arg) {
    char buffer[BUFFER_SIZE];
    while (1) {
        memset(buffer, 0, sizeof(buffer));
        int bytes = read(sock, buffer, sizeof(buffer));
        if (bytes <= 0) {
            printf("\nDisconnected from server.\n");
            exit(0);
        }
        printf("%s", buffer);
        fflush(stdout);
    }
    return NULL;
}

int main() {
    sock = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in serv_addr = { .sin_family = AF_INET, .sin_port = htons(PORT) };
    inet_pton(AF_INET, "127.0.0.1", &serv_addr.sin_addr);

    if (connect(sock, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        printf("Connection failed.\n");
        return -1;
    }

    printf("Enter your chat username: ");
    fgets(username, sizeof(username), stdin);
    username[strcspn(username, "\n")] = 0;

    pthread_t recv_thread;
    pthread_create(&recv_thread, NULL, recv_handler, NULL);
    pthread_detach(recv_thread);

    printf("--- Joined Chat Room (Type messages and press Enter) ---\n");

    char message[BUFFER_SIZE];
    char formatted_msg[BUFFER_SIZE + 64];

    while (fgets(message, sizeof(message), stdin)) {
        if (strcmp(message, "exit\n") == 0) break;
        snprintf(formatted_msg, sizeof(formatted_msg), "[%s]: %s", username, message);
        send(sock, formatted_msg, strlen(formatted_msg), 0);
    }

    close(sock);
    return 0;
}
