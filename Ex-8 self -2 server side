2. Hospital Appointment Management System
Server (hospital_server.c)

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define PORT 8082

struct Doctor { int id; char name[30]; char timing[20]; int slots; };
struct Doctor db[2] = {{1, "Dr. Smith", "10AM-12PM", 5}, {2, "Dr. Adams", "2PM-4PM", 2}};

void log_txn(const char *msg) {
    FILE *f = fopen("hospital_log.txt", "a");
    if(f) {
        time_t t = time(NULL); char *tm = ctime(&t); tm[strlen(tm)-1] = 0;
        fprintf(f, "[%s] %s\n", tm, msg); fclose(f);
    }
}

int main() {
    int server_sock = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in addr = { .sin_family = AF_INET, .sin_port = htons(PORT), .sin_addr.s_addr = INADDR_ANY };
    bind(server_sock, (struct sockaddr*)&addr, sizeof(addr)); listen(server_sock, 5);
    printf("Iterative Hospital Server listening on %d...\n", PORT);

    while(1) {
        int client_sock = accept(server_sock, NULL, NULL);
        char buffer[1024], response[2048];
        log_txn("Patient connected.");
        
        while(read(client_sock, buffer, sizeof(buffer)) > 0) {
            int cmd = 0, id = 0; sscanf(buffer, "%d %d", &cmd, &id);
            memset(response, 0, sizeof(response));
            
            if (cmd == 1) { 
                strcpy(response, "ID\tName\tTiming\tSlots\n");
                for(int i=0; i<2; i++) {
                    char temp[100]; sprintf(temp, "%d\t%s\t%s\t%d\n", db[i].id, db[i].name, db[i].timing, db[i].slots);
                    strcat(response, temp);
                }
                log_txn("Searched doctors.");
            } else if (cmd == 2 || cmd == 3) {
                int found = -1;
                for(int i=0; i<2; i++) if (db[i].id == id) found = i;
                if (found != -1) {
                    if (cmd == 2 && db[found].slots > 0) {
                        db[found].slots--; strcpy(response, "Appointment Confirmed!"); log_txn("Appointment booked.");
                    } else if (cmd == 3) {
                        db[found].slots++; strcpy(response, "Appointment Cancelled!"); log_txn("Appointment cancelled.");
                    } else {
                        strcpy(response, "Error: No slots available."); log_txn("Booking failed.");
                    }
                } else { strcpy(response, "Error: Invalid Doctor ID."); log_txn("Invalid ID."); }
            }
            send(client_sock, response, strlen(response), 0);
            memset(buffer, 0, sizeof(buffer));
        }
        close(client_sock); log_txn("Patient disconnected.");
    }
    return 0;
}
