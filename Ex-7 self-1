1. Go-Back-N Sliding Window Protocol (Self-Question 1)
This C program simulates the Go-Back-N protocol. It accepts the window size, total frames, and a specific frame to drop to simulate loss and demonstrate retransmission of the entire window from that point.  


#include <stdio.h>

int main() {
    int window_size, total_frames, lost_frame;
    
    printf("Enter window size: ");
    scanf("%d", &window_size);
    printf("Enter total number of frames to send: ");
    scanf("%d", &total_frames);
    printf("Enter the frame number to simulate as lost/corrupted (0 for none): ");
    scanf("%d", &lost_frame);

    int current_frame = 1;
    int total_transmissions = 0;

    while (current_frame <= total_frames) {
        int frames_to_send = window_size;
        if (current_frame + window_size - 1 > total_frames) {
            frames_to_send = total_frames - current_frame + 1;
        }

        printf("\n--- Transmitting Window starting at Frame %d ---\n", current_frame);
        for (int i = 0; i < frames_to_send; i++) {
            printf("Transmitting Frame %d\n", current_frame + i);
            total_transmissions++;
        }

        int ack_received = 1;
        for (int i = 0; i < frames_to_send; i++) {
            int frame_id = current_frame + i;
            if (frame_id == lost_frame) {
                printf("! Timeout: Frame %d lost or corrupted.\n", frame_id);
                printf("! Discarding all subsequent frames in this window.\n");
                printf("! Go-Back-N triggered. Retransmitting from Frame %d...\n", frame_id);
                lost_frame = -1; // Reset to prevent infinite loop on the same frame
                ack_received = 0;
                break;
            } else {
                printf("Acknowledgment received for Frame %d\n", frame_id);
            }
        }

        if (ack_received) {
            current_frame += frames_to_send;
        }
    }
    
    printf("\nData delivery successful!\n");
    printf("Total transmissions required: %d\n", total_transmissions);
    return 0;
}
